# Copy this file to .env.local and fill in the values from your Supabase
# project (Dashboard -> Project Settings -> API). .env.local is git-ignored.
# The anon key is safe to expose in the browser; row level security controls
# what it can do. Never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
